datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String?  @unique
  passwordHash String?
  phone        String   @unique
  pin          String   @default("123456")
  role         String   @default("cashier") // owner, cashier, chef, accountant
  avatar       String?
  department   String?
  createdAt    DateTime @default(now())
}

model Product {
  id             String   @id @default(cuid())
  nameAr         String
  nameEn         String
  category       String
  basePrice      Float
  originalPrice  Float?   // السعر الأصلي المشطوب (e.g., 420 EGP)
  promoPrice     Float?   // سعر العرض (e.g., 370 EGP)
  promoDays      String?  // أيام العرض: "الثلاثاء والأربعاء والخميس"
  promoActive    Boolean  @default(false)
  isFlashDeal    Boolean  @default(false)
  trayComponents String?  // JSON: ["نص فرخة بروستد", "نص فرخة مشوي", ...]
  modifiers      String?  // JSON: [{nameAr, nameEn, price}]
  sizes          String?  // JSON: [{nameAr, nameEn, price}]
  recipe         String?  // JSON: [{ingredientId, ingredientName, qty, unit}]
  image          String?
  description    String?
  isAvailable    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerName  String
  phone         String
  address       String?
  zone          String   @default("الحي الثاني - 6 أكتوبر")
  orderType     String   @default("delivery") // delivery, takeaway, dinein
  status        String   @default("new") // new, preparing, ready, with_captain, delivered, cancelled
  items         String   // JSON: [{productId, nameAr, nameEn, qty, unitPrice, selectedSize, extras:[]}]
  subtotal      Float
  deliveryFee   Float    @default(0)
  total         Float
  deposit       Float    @default(0)
  remaining     Float
  paymentMethod String   @default("cash") // cash, instapay, wallet, card
  notes         String?
  assignedChef  String?
  captainName   String?  // الطيار المسئول عن التوصيل
  captainPhone  String?  // رقم هاتف الطيار
  customerEmail String?  // إيميل العميل (اختياري)
  customerId    String?  // معرف حساب العميل المسجل
  timeline      String   @default("[]") // JSON: [{stage, at, by}]
  saro5RefId    String?  // كود التتبع في تطبيق صاروخ
  foodCost      Float?   @default(0)
  netProfit     Float?   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?  @unique
  address     String?
  zone        String?
  otpCode     String?
  otpExpires  DateTime?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Captain {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  vehicle   String?  @default("سكوتر / موتوسيكل") // سكوتر، موتوسيكل، عجلة
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String
  unit        String   @default("كيلو")
  quantity    Float    @default(0)
  minStock    Float    @default(1)
  costPerUnit Float    @default(0)
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  expenseDate String   // YYYY-MM-DD
  category    String   @default("تشغيل")
  recordedBy  String?
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(cuid())
  senderId      String?
  senderName    String
  senderRole    String?
  text          String
  orderId       String?
  customerPhone String?
  isStaff       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model SystemSettings {
  id                    String   @id @default("default")
  restaurantName        String   @default("مطعم الوجبة الشهية")
  phone                 String   @default("01019845220")
  hotlines              String   @default("01019845220 | 01111316817 | 01111316439")
  address               String   @default("6 أكتوبر - الحي الثاني - شارع جيل 2000 - المجاورة الثانية، عمارة 661 - مقابل مدرسة أم المؤمنين")
  deliveryZones         String   @default("[]") // JSON: [{name, fee}]
  soundsEnabled         Boolean  @default(true)
  offersEnabled         Boolean  @default(true)
  specialOffers         String?
  isLockedDown          Boolean  @default(false)
  whatsappOrdersEnabled Boolean  @default(true)
  ownerWhatsapp         String?  @default("01019845220")
  saro5WebhookUrl       String?
  talabatWebhookUrl     String?
  updatedAt             DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  nameAr    String   @unique
  nameEn    String?
  image     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model DeliveryZone {
  id           String   @id @default(cuid())
  code         String?  // كود المنطقة (e.g. 6OCT-01)
  nameEn       String   // e.g. "District 2"
  nameAr       String   // e.g. "الحي الثاني"
  fee          Float    // رسوم التوصيل بالجنيه
  timeMinutes  Int      @default(40) // وقت التوصيل بالدقائق
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model InventoryAudit {
  id          String   @id @default(cuid())
  title       String   // مثلاً: جرد أسبوعي
  periodStart String?  // YYYY-MM-DD
  periodEnd   String?  // YYYY-MM-DD
  totalCost   Float    // إجمالي تكلفة الخامات المستهلكة
  itemsCount  Int      @default(0)
  items       String   // JSON: [{ingredientId, name, unit, prevQty, actualQty, consumedQty, costPerUnit, totalCost}]
  recordedBy  String?
  expenseId   String?  // معرّف المصروف المترحل تلقائياً
  createdAt   DateTime @default(now())
}

model Purchase {
  id             String   @id @default(cuid())
  ingredientId   String
  ingredientName String
  quantity       Float
  unitPrice      Float
  totalCost      Float
  prevQty        Float
  newQty         Float
  prevCost       Float
  newAvgCost     Float
  invoiceNumber  String?
  supplier       String?
  notes          String?
  recordedBy     String?
  expenseId      String?
  createdAt      DateTime @default(now())
}
